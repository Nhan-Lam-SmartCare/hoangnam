{
  "name": "motocarepro-standalone",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "migrate:workorder-codes": "node scripts/setup/apply-sql.mjs sql/2026-04-02_migrate_work_order_ids_compact.sql",
    "migrate:secure-profiles": "node scripts/setup/apply-sql.mjs sql/2026-06-19_secure_profiles_and_remaining_tables.sql",
    "migrate:secure-followup": "node scripts/setup/apply-sql.mjs sql/2026-06-19_followup_payment_sources_and_employee_salary.sql",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives",
    "lint:json": "eslint src --ext ts,tsx --format json",
    "lint:baseline": "node scripts/maintenance/generate-lint-baseline.mjs",
    "lint:fix": "eslint src --ext ts,tsx --fix",
    "test": "vitest run --environment jsdom",
    "test:unit": "vitest run --environment jsdom --exclude \"tests/integration/**\" --exclude \"e2e/**\" --exclude \"node_modules/**\"",
    "test:watch": "vitest --environment jsdom",
    "ci:test:critical": "vitest run tests/integration/rls_user_flow.test.ts --environment jsdom",
    "test:integration:critical": "vitest run tests/integration/receipt_create_atomic.test.ts tests/integration/rls_access.test.ts tests/integration/inventory_trigger_correctness.test.ts --environment jsdom",
    "cap:sync": "npm run build && npx cap sync",
    "cap:open": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/share": "^8.0.1",
    "@supabase/supabase-js": "^2.76.1",
    "@tanstack/react-query": "^5.90.5",
    "@tanstack/react-query-devtools": "^5.90.2",
    "@zxing/library": "^0.21.3",
    "core-js": "^3.49.0",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "html2canvas": "^1.4.1",
    "html5-qrcode": "^2.3.8",
    "jsbarcode": "^3.12.1",
    "jspdf": "^3.0.3",
    "jspdf-autotable": "^5.0.2",
    "lucide-react": "^0.469.0",
    "papaparse": "^5.5.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.3",
    "react-toastify": "^11.0.5",
    "recharts": "^3.3.0",
    "tesseract.js": "^7.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.3.4",
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "jsdom": "^27.1.0",
    "postcss": "^8.4.0",
    "puppeteer": "^24.33.0",
    "tailwindcss": "^3.4.4",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.2.0",
    "vitest": "^2.1.4"
  }
}
